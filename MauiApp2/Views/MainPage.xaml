<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.MainPage"
             Shell.NavBarIsVisible="False">
             
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label
                Text="Gym Tracker"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource AppAccent}"
                HorizontalOptions="Center" />

            <!-- Log a Set card -->
            <Frame
                Padding="16"
                CornerRadius="2"
                BackgroundColor="{StaticResource AppSurface}"
                BorderColor="{StaticResource AppAccent}"
                HasShadow="True">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Log a Set" FontSize="18" FontAttributes="Bold" />

                    <Picker x:Name="ExercisePicker" Title="Select Exercise" />

                    <HorizontalStackLayout Spacing="12">
                        <Entry x:Name="WeightInput"
                               Placeholder="Weight (kg)"
                               Keyboard="Numeric"
                               WidthRequest="140" />
                        <Entry x:Name="RepsInput"
                               Placeholder="Reps"
                               Keyboard="Numeric"
                               WidthRequest="140" />
                    </HorizontalStackLayout>

                    <Button Text="Add Set" Clicked="OnAddSetClicked" />

                </VerticalStackLayout>
            </Frame>

            <!-- Current workout summary -->
            <Frame
                Padding="16"
                CornerRadius="2"
                BackgroundColor="{StaticResource AppSurface}"
                BorderColor="LightGray"
                HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Current Workout" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="SetsLabel" Text="No sets logged yet." />
                </VerticalStackLayout>
            </Frame>

            <!-- Finish workout -->
            <Button
                Text="Finish Workout"
                Clicked="OnFinishWorkoutClicked"
                BackgroundColor="DarkGreen"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>