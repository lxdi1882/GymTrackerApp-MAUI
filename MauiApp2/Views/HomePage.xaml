<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.HomePage"
             BackgroundColor="#181818">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="20">

            <Label Text="Welcome back"
                   TextColor="#A0A0A0"
                   FontSize="15" />

            <Label x:Name="NextWorkoutLabel"
                   Text="Push day is next"
                   TextColor="White"
                   FontSize="34"
                   FontAttributes="Bold" />

            <!-- Metric cards -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BackgroundColor="#262626"
                        Stroke="Transparent"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Streak" TextColor="#A0A0A0" FontSize="14" />
                        <Label x:Name="StreakValueLabel" Text="-" TextColor="White" FontSize="24" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#262626"
                        Stroke="Transparent"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PRs this week" TextColor="#A0A0A0" FontSize="14" />
                        <Label x:Name="PrCountLabel" Text="-" TextColor="White" FontSize="24" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Start workout button -->
            <Border BackgroundColor="White"
                    Stroke="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Button Text="Start workout"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        FontSize="16"
                        HeightRequest="56"
                        Clicked="OnStartWorkoutClicked" />
            </Border>

            <!-- Last workout -->
          
<Label Text="Last workout" TextColor="#A0A0A0" FontSize="15" Margin="0,12,0,0" />

<Border BackgroundColor="#262626"
        Stroke="Transparent"
        Padding="16">
    <Border.StrokeShape>
        <RoundRectangle CornerRadius="12" />
    </Border.StrokeShape>
    <VerticalStackLayout Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" x:Name="LastWorkoutTitleLabel" Text="-" TextColor="White" FontAttributes="Bold" />
            <Label Grid.Column="1" x:Name="LastWorkoutCountLabel" Text="-" TextColor="#A0A0A0" FontSize="13" />
        </Grid>

        <BoxView HeightRequest="0.5" BackgroundColor="#3A3A3A" />

        <CollectionView x:Name="LastWorkoutSetsView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExerciseRowTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding ExerciseName}" TextColor="White" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding SetCountText}" TextColor="#A0A0A0" FontSize="13" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding ChevronGlyph}" TextColor="#A0A0A0" FontSize="11" />
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                              BindableLayout.ItemsSource="{Binding SetLines}"
                                              Spacing="4"
                                              Padding="12,0,0,8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" TextColor="#A0A0A0" FontSize="13" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="0.5" BackgroundColor="#333333" />

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</Border>

            <!-- Recent PRs -->
            <Label Text="Recent PRs" TextColor="#A0A0A0" FontSize="15" Margin="0,12,0,0" />

            <CollectionView x:Name="RecentPrsView">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#0F2A17"
                                Stroke="Transparent"
                                Padding="16,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding ExerciseName}" TextColor="#4ADE80" FontSize="14" />
                                <Label Grid.Column="1" Text="{Binding ResultText}" TextColor="#4ADE80" FontSize="14" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
