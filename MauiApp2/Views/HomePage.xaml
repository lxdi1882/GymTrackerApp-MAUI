<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.HomePage">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="20">

            <Label Text="Welcome back"
                   Style="{StaticResource SubHeadline}" />

            <Label x:Name="StreakLabel"
                   Text="Streak: -"
                   Style="{StaticResource Headline}" />

            <Button Text="Start Workout"
                    Clicked="OnStartWorkoutClicked" />

            <Label Text="Last Workout"
                   Style="{StaticResource SubHeadline}" />
            <Label x:Name="LastWorkoutLabel"
                   Text="No sessions yet" />

            <Label Text="Recent PRs"
                   Style="{StaticResource SubHeadline}" />
            <Label x:Name="RecentPrsLabel"
                   Text="No PRs yet" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>