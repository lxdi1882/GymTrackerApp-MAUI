<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.HistoryPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" BindableLayout.ItemsSource="{Binding}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="16"
                        CornerRadius="2"
                        BackgroundColor="{StaticResource AppSurface}"
                        BorderColor="{StaticResource AppAccent}"
                        HasShadow="True">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DayLabel}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppAccent}" />
                            <Label Text="{Binding Date}" FontSize="14" TextColor="{StaticResource AppTextSecondary}" />
                            <Label Text="{Binding TotalSets, StringFormat='{0} sets logged'}" FontSize="14" />
                            <Label Text="{Binding ExerciseNames.Count, StringFormat='{0} exercises'}" FontSize="14" TextColor="{StaticResource AppTextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>